# Learn more https://docs.expo.dev/guides/monorepos/#ignore-native-folders

node_modules/

# Native folders are GENERATED by prebuild, not authored.
#
# Committing android/ or ios/ switches EAS out of the CNG (Continuous Native
# Generation) workflow: it uses the checked-in folder as-is and stops applying
# app.json. That is why the rename to "Line Dash" and the new bundle
# identifier had no effect on the Android build - app.json was being ignored.
/android
/ios

# Local Expo state: device history and dev-server settings, machine-specific.
.expo/
dist/
web-build/
expo-env.d.ts

# Native build artefacts
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# Debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store

# Environment - keep secrets out of git. EXPO_PUBLIC_ vars are inlined into
# the bundle so they are not secret from users, but they still don't belong
# in version control.
.env
.env.local
.env*.local